{
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://localhost:1420/*",
      "http://127.0.0.1:1420/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-open",
    "shell:allow-execute"
  ]
}
